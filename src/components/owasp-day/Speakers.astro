---
// Oradores: salen de las charlas de src/content/owasp-day-2026/talks.yaml, en el orden de la lista, y solo
// los publicados (ver src/lib/agenda.ts). Una charla con dos oradores genera dos tarjetas; el panel, una por
// panelista publicado. Las fotos se muestran en B/N; sin foto se usa la silueta
// src/assets/owasp-day/speakers/placeholder.svg.
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import placeholder from '~/assets/owasp-day/speakers/placeholder.svg';
import SocialIcon from '~/components/SocialIcon.astro';
import { url } from '~/lib/events';
import { fullName, isPublished, visibleSpeakers } from '~/lib/agenda';
import { inline } from './format';

interface Props { event: CollectionEntry<'owaspDay'>['data']; all?: boolean }
const { event: { speakers: s }, all = false } = Astro.props;
const byId = (a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id, 'es', { numeric: true });
const talks = (await getCollection('owaspDayTalks')).sort(byId);

// Título genérico de cada charla (agenda.yaml), para las que todavía no se publican (ej. el panel).
const generic = new Map<string, string>();
for (const { data } of await getCollection('owaspDayAgenda')) for (const ses of data.sessions) if (ses.talk) generic.set(ses.talk, ses.title);

// Fotos: ./speakers/<nombre>.jpg junto a talks.yaml. Las sirve src/pages/owasp-meetup-plus-2026/oradores/
// (no se importan acá: ver ese archivo).
const photoUrl = (photo?: string) => photo && url(`/owasp-meetup-plus-2026/oradores/${photo.replace(/^.*\/|\.[^.]+$/g, '')}.webp`);
const speakers = talks.flatMap(({ id, data: t }) =>
  visibleSpeakers(t, all).map((sp) => ({ ...sp, talk: isPublished(t, all) ? t.title : generic.get(id), photoSrc: photoUrl(sp.photo) })),
);
---
<section class="section section--dark speakers" id="oradores" aria-labelledby="oradores-title">
  <span class="deco deco--speakers-blue" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Oradores</p>
        <span class="bar" aria-hidden="true"></span>
        <h2 class="section-title" id="oradores-title" set:html={inline(s.title)} />
      </div>
      {s.note && <p class="section-head__note">{s.note}</p>}
    </div>

    <ul class="speakers__grid">
      {speakers.map((sp, i) => {
        const name = fullName(sp);
        return (
          <li class="speaker">
            <div class:list={['speaker__photo', `speaker__photo--${sp.color ?? (i % 2 ? 'blue' : 'yellow')}`]}>
              {sp.photoSrc
                ? <img src={sp.photoSrc} alt={`Foto de ${name}`} width="400" height="400" loading="lazy" decoding="async" />
                : <Image src={placeholder} alt={`Foto de ${name} (placeholder)`} width={400} height={400} />}
            </div>
            <h3 class="speaker__name">{sp.name} {sp.lastName && <span>{sp.lastName}</span>}</h3>
            <p class="speaker__role">
              {sp.role}
              {sp.linkedin && (
                <a class="speaker__social" href={sp.linkedin} rel="noopener" aria-label={`LinkedIn de ${name}`}><SocialIcon name="linkedin" /></a>
              )}
            </p>
            {sp.talk && <p class="speaker__talk">{sp.talk}</p>}
          </li>
        );
      })}
      {s.moreTile && (
        <li class="speaker speaker--more">
          <span class="speaker--more__icon" aria-hidden="true"></span>
          <p class="speaker--more__title" set:html={inline(s.moreTitle, { hl: '' })} />
          <p class="speaker--more__text">{s.moreText}</p>
          {s.moreLink.label && s.moreLink.url && <a class="link-arrow" href={url(s.moreLink.url)}>{s.moreLink.label}</a>}
        </li>
      )}
    </ul>
  </div>
</section>
