---
// Envuelve una sección. Si se ve solo por SHOW_HIDDEN, la marca para no confundirla con lo publicado.
interface Props { forced: boolean; label?: string }
const { forced, label = 'Oculta en producción' } = Astro.props;
---
{forced
  ? <div class="dev-hidden" data-label={label}><slot /></div>
  : <slot />}
