---
// Hero del evento: fecha, sede, horario, botones (CFS y registro) y cuenta regresiva.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Arrow from '~/components/Arrow.astro';
import hero from '~/assets/hero-salvo.webp';
import avispa from '~/assets/brand/avispa-blanca.svg';
import { NOW } from '~/lib/env';
import { heroCtas, startOf, timeLabel } from '~/lib/when';
import { longDate } from './format';

interface Props { event: CollectionEntry<'owaspDay'>['data'] }
const { event } = Astro.props;
const ctas = heroCtas({ cfpUrl: event.cfp.url, cfpDeadline: event.cfp.deadline, registrationUrl: event.registration.url, now: NOW });
const start = startOf(event.date, event.time);
---
<section class="hero hero--event" aria-labelledby="hero-title">
  <div class="hero__inner">
  <div class="hero__text">
    <Image class="hero__mark" src={avispa} alt="" width={72} height={72} loading="eager" />
    <h1 class="hero__title" id="hero-title">
      <span class="hero__owasp">OWASP</span>
      <span class="hero__day">DAY</span>
      <span class="visually-hidden">Uruguay 2026</span>
    </h1>
    <p class="hero__city">{event.hero.city}</p>
    <span class="bar" aria-hidden="true"></span>
    <ul class="hero__facts">
      <li><time datetime={event.date}>{longDate(event.date)}</time></li>
      <li>{event.venue.name}</li>
      <li data-time>{timeLabel(event.time)}</li>
    </ul>
    <div class="hero__ctas">
      {ctas.map((c, i) => c.disabled
        ? <span class="btn btn--lg btn--outline-white is-disabled" aria-disabled="true" data-cta={c.id}>{c.label}</span>
        : <a class:list={['btn', 'btn--lg', i === 0 ? 'btn--yellow' : 'btn--outline-white']} href={c.href} rel="noopener" data-cta={c.id}>{c.label} <Arrow /></a>)}
    </div>
    <p class="countdown" data-countdown={start.toISOString()} aria-live="off"></p>
  </div>

  <div class="hero__art">
    <span class="shape shape--blue-half" aria-hidden="true"></span>
    <span class="shape shape--sun" aria-hidden="true"></span>
    <span class="hero__photo">
      <Image src={hero} alt={event.hero.photoAlt} widths={[640, 1025, 1280]} sizes="(max-width: 900px) 100vw, 1025px" loading="eager" fetchpriority="high" />
    </span>
    <span class="shape shape--blue-corner" aria-hidden="true"></span>
    <span class="shape shape--dots" aria-hidden="true"></span>
  </div>
  </div>
</section>

<script>
  // Cuenta regresiva. Sin JS no se muestra nada: la fecha ya está arriba.
  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const target = new Date(el.dataset.countdown!).valueOf();
    const tick = () => {
      const ms = target - Date.now();
      if (ms <= 0) { el.textContent = ''; return; }
      const d = Math.floor(ms / 864e5);
      const h = Math.floor((ms % 864e5) / 36e5);
      const m = Math.floor((ms % 36e5) / 6e4);
      el.textContent = `Faltan ${d} ${d === 1 ? 'día' : 'días'}, ${h} h y ${m} min`;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
