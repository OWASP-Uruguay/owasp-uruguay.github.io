---
// Agenda: src/content/owasp-day-2026/agenda.yaml. Una o dos sesiones por franja;
// kind break/mate = pausa. Tracks: main/keynote/panel (amarillo) y lab (azul).
// Con published (sections.talks) cada sesión con `talk` toma título, oradores y resumen de talks.yaml;
// sin published solo se ve el texto genérico de agenda.yaml.
import { getCollection, type CollectionEntry } from 'astro:content';
import { inline, paragraphs } from './format';
import { resolveSession } from '~/lib/agenda';

interface Props { event: CollectionEntry<'owaspDay'>['data']; published?: boolean }
const { event: { agenda }, published = false } = Astro.props;
const byId = (a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id, 'es', { numeric: true });
const slots = (await getCollection('owaspDayAgenda')).sort(byId);
const talks = published ? new Map((await getCollection('owaspDayTalks')).map((t) => [t.id, t.data])) : new Map();
const trackLabel = { main: 'Charla', lab: 'Taller', keynote: 'Keynote', panel: 'Panel' } as const;
const hasLab = slots.some(({ data }) => data.sessions.some((s) => s.track === 'lab'));
---
<section class="section section--light agenda" id="agenda" aria-labelledby="agenda-title">
  <span class="deco deco--agenda-quarter" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Agenda</p>
        <span class="bar" aria-hidden="true"></span>
        <h2 class="section-title" id="agenda-title" set:html={inline(agenda.title)} />
      </div>
      {hasLab && (
        <ul class="legend" aria-label="Salas">
          <li><span class="dot dot--yellow" aria-hidden="true"></span>Charla</li>
          <li><span class="dot dot--blue" aria-hidden="true"></span>Taller</li>
        </ul>
      )}
    </div>
    {agenda.note && <p class="agenda__note" set:html={inline(agenda.note, { hl: false })} />}

    <ol class="schedule">
      {slots.map(({ data: slot }) => {
        const isBreak = slot.kind !== 'session';
        return (
          <li class:list={['slot', { 'slot--break': isBreak, 'slot--mate': slot.kind === 'mate' }]}>
            <time datetime={/^\d{2}:\d{2}$/.test(slot.time) ? slot.time : undefined}>{slot.time}</time>
            <div class:list={['slot__sessions', { 'slot__sessions--2': slot.sessions.length > 1 }]}>
              {slot.sessions.map((raw) => {
                const session = resolveSession(raw, raw.talk ? talks.get(raw.talk) : undefined, published);
                const track = isBreak ? undefined : (raw.track ?? 'main');
                return (
                  <div class="session">
                    {track && <span class:list={['slot__track', track === 'lab' ? 'slot__track--lab' : 'slot__track--main']}>{trackLabel[track]}</span>}
                    <p class="session__title">
                      {session.title}
                      {session.talk?.language === 'en' && <span class="session__lang" title="Charla en inglés">EN</span>}
                    </p>
                    {session.by && <p>{session.by}</p>}
                    {session.talk?.abstract && (
                      <details class="session__abstract">
                        <summary>Ver resumen</summary>
                        {paragraphs(session.talk.abstract).map((html) => <p set:html={html} />)}
                      </details>
                    )}
                  </div>
                );
              })}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
