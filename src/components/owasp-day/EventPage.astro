---
// Página completa del OWASP Meetup+ 2026. La usan /owasp-meetup-plus-2026/ y la portada mientras el evento no pasó.
// Las secciones apagadas en event.yaml (sections) no se renderizan, ni sus datos.
import { getCollection, getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import '~/styles/chapter.css';
import '~/styles/owasp-day.css';
import Hero from './Hero.astro';
import About from './About.astro';
import CallForSpeakers from './CallForSpeakers.astro';
import Speakers from './Speakers.astro';
import Agenda from './Agenda.astro';
import Venue from './Venue.astro';
import Sponsors from './Sponsors.astro';
import Faq from './Faq.astro';
import Conduct from './Conduct.astro';
import Hidden from './Hidden.astro';
import { NOW, SHOW_HIDDEN } from '~/lib/env';
import { heroCtas } from '~/lib/when';
import { resolveSections } from '~/lib/flags';
import { visibleSpeakers } from '~/lib/agenda';

interface Props { canonicalPath?: string }
const entry = await getEntry('owaspDay', 'event');
if (!entry) throw new Error('Falta src/content/owasp-day-2026/event.yaml');
const event = entry.data;
const { on, forced } = resolveSections(event.sections, SHOW_HIDDEN);
// La grilla de oradores aparece sola cuando hay al menos uno publicado en talks.yaml.
const talks = await getCollection('owaspDayTalks');
const showSpeakers = on.speakers && talks.some(({ data }) => visibleSpeakers(data, on.talks).length > 0);
const talksLabel = 'Incluye charlas y oradores sin publicar';

const [cta] = heroCtas({ cfpUrl: event.cfp.url, cfpDeadline: event.cfp.deadline, registrationUrl: event.registration.url, now: NOW });
const anchors = [
  { label: 'Acerca de', href: '#acerca' },
  { label: 'Participá', href: '#cfs' },
  ...(showSpeakers ? [{ label: 'Oradores', href: '#oradores' }] : []),
  ...(on.agenda ? [{ label: 'Agenda', href: '#agenda' }] : []),
  { label: 'Sede', href: '#sede' },
  ...(on.faq ? [{ label: 'FAQ', href: '#faq' }] : []),
];
---
<Base
  title={event.title}
  description={event.description}
  variant="owasp-day"
  eventBar={{ title: 'OWASP Meetup+ 2026', items: anchors, cta: { label: cta.label, href: cta.href, disabled: cta.disabled } }}
  eventNav={anchors}
  canonicalPath={Astro.props.canonicalPath}
>
  <Hero event={event} />
  <About event={event} />
  <CallForSpeakers event={event} />
  {showSpeakers && (
    <Hidden forced={forced.has('speakers') || forced.has('talks')} label={forced.has('speakers') ? undefined : talksLabel}>
      <Speakers event={event} all={on.talks} />
    </Hidden>
  )}
  {on.agenda && (
    <Hidden forced={forced.has('agenda') || forced.has('talks')} label={forced.has('agenda') ? undefined : talksLabel}>
      <Agenda event={event} all={on.talks} />
    </Hidden>
  )}
  <Venue event={event} />
  {on.sponsors && <Hidden forced={forced.has('sponsors')}><Sponsors event={event} /></Hidden>}
  {on.faq && <Hidden forced={forced.has('faq')}><Faq event={event} /></Hidden>}
  <Conduct />
</Base>
