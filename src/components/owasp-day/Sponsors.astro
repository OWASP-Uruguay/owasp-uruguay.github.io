---
// Quienes acompañan el evento: src/content/owasp-day-2026/sponsors.yaml, agrupados por nivel.
// En la web no se les dice "sponsors": los niveles son Apoyan, Venue y Comunidad.
// Todos los niveles comparten la misma grilla de columnas, así las tarjetas quedan alineadas entre filas.
// Dentro de un nivel, los logos se igualan por área visual (no por alto): uno ancho y uno cuadrado
// "pesan" lo mismo. `scale` en el YAML corrige casos puntuales.
// Sin logo se muestra el recuadro punteado con el nombre. La sección no tiene encabezado visible:
// los títulos de cada nivel alcanzan (el h2 queda solo para lectores de pantalla).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const all = (await getCollection('owaspDaySponsors')).sort((a, b) => a.id.localeCompare(b.id));
const tiers = [
  { id: 'apoyan', name: 'Apoyan' },
  { id: 'venue', name: 'Venue' },
  { id: 'comunidad', name: 'Comunidad' },
] as const;
const groups = tiers
  .map((tier) => ({ ...tier, list: all.filter((sp) => sp.data.tier === tier.id).map((sp) => sp.data) }))
  .filter((g) => g.list.length > 0);
// Factor de ancho del logo: raíz de la proporción ancho/alto, así ancho × alto queda constante.
const k = (sp: (typeof groups)[number]['list'][number]) =>
  sp.logo ? Math.sqrt(sp.logo.width / sp.logo.height) * sp.scale : 1;
---
<section class="section section--light sponsors" id="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <h2 class="visually-hidden" id="sponsors-title">Nos acompañan</h2>
    <div class="backers">
      {groups.map((g) => (
        <div class:list={['backers__group', `backers__group--${g.id}`]}>
          <h3 class="tier__name">{g.name}</h3>
          <ul class="backers__logos" role="list">
            {g.list.map((sp) => {
              const content = sp.logo
                ? <Image src={sp.logo} alt={sp.name} width={Math.round(2 * 96 * k(sp))} style={`--k: ${k(sp).toFixed(3)}`} />
                : <span class="sponsor__ph">{sp.name}</span>;
              return (
                <li class="sponsor">
                  {sp.url ? <a href={sp.url} rel="noopener">{content}</a> : content}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
